{
	"name": "dav-api",
	"version": "1.0.0",
	"main": "dist/server.js",
	"type": "module",
	"scripts": {
		"start": "node dist/server.js",
		"dev": "concurrently \"npm:build:watch\" \"npm:serve:watch\"",
		"dev:email": "email dev --dir src/emails",
		"build": "prisma generate && tsc",
		"build:watch": "tsc -w",
		"serve:watch": "nodemon dist/server.js",
		"typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:services:up": "docker compose -f compose.test.yml up -d --wait",
		"test:services:down": "docker compose -f compose.test.yml down",
		"test:db:prepare": "node scripts/prepare-test-database.mjs",
		"test:integration": "npm run test:db:prepare && vitest run --config vitest.integration.config.ts",
		"test:system": "npm run build && npm run test:db:prepare && vitest run --config vitest.system.config.ts",
		"test:all": "npm run build && npm run typecheck && npm test && npm run test:integration && npm run test:system"
	},
	"license": "MIT",
	"dependencies": {
		"@apollo/server": "^5.5.1",
		"@as-integrations/express5": "^1.1.2",
		"@aws-sdk/client-s3": "^3.1135.0",
		"@aws-sdk/s3-request-presigner": "^3.1135.0",
		"@graphql-tools/schema": "^10.1.1",
		"@graphql-tools/utils": "^12.0.1",
		"@paralleldrive/cuid2": "^3.3.0",
		"@prisma/adapter-pg": "^7.10.0",
		"@prisma/client": "^7.10.0",
		"@react-email/components": "1.0.12",
		"axios": "^1.20.0",
		"bcrypt": "^6.0.0",
		"cors": "^2.8.6",
		"dotenv": "^18.0.0",
		"express": "^5.2.1",
		"graphql": "^16.14.2",
		"graphql-type-json": "^0.3.2",
		"image-type": "^5.2.0",
		"luxon": "^3.4.4",
		"node-cron": "^3.0.3",
		"pg": "^8.23.0",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"redis": "^4.6.13",
		"resend": "^4.0.1",
		"stripe": "^14.12.0",
		"tailwindcss": "^3.4.16",
		"validator": "^13.11.0",
		"web-push": "^3.6.7"
	},
	"devDependencies": {
		"@react-email/ui": "6.9.5",
		"@types/bcrypt": "^5.0.2",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/luxon": "^3.4.2",
		"@types/node": "22.13.10",
		"@types/node-cron": "^3.0.11",
		"@types/pg": "^8.23.1",
		"@types/react": "^19.3.0",
		"@types/supertest": "^6.0.3",
		"@types/validator": "^13.11.9",
		"@types/web-push": "^3.6.3",
		"@vitest/coverage-v8": "^3.2.7",
		"concurrently": "^8.2.2",
		"nock": "^14.0.17",
		"nodemon": "^3.0.2",
		"prisma": "^7.10.0",
		"react-email": "6.9.5",
		"supertest": "^7.2.2",
		"typescript": "^5.9.3",
		"vitest": "^3.2.7"
	}
}
