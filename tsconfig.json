{
	"compilerOptions": {
		"module": "Node16",
		"target": "ES2022",
		"outDir": "./dist",
		"moduleResolution": "Node16",
		"allowSyntheticDefaultImports": true,
		"jsx": "react-jsx",
		"strictNullChecks": false,
		// @react-email/tailwind ships .d.mts files that need css-tree types and a
		// newer lib than this project targets. Only its declarations are affected.
		"skipLibCheck": true
	},
	"include": ["server.ts", "src/**/*.ts", "src/**/*.tsx"]
}
